{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "vitest"],
    "baseUrl": ".",
    "paths": {
      "@app/*": ["apps/loan-portal/src/*"],
      "@src/*": ["src/*"]
    }
  },
  "include": ["apps/**/*.ts", "src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "*.ts"]
}
